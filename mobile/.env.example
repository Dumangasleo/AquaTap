# Optional: full URL of the AquaTap API (e.g. a deployed server).
# Leave empty during development: the app uses the IP of the computer running `npx expo start`.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000/api/v1

# Google Cloud Console > Credentials > OAuth client ID of type "Web application" (same value as backend GOOGLE_WEB_CLIENT_ID)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
