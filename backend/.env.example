PORT=3000

DB_HOST=localhost
DB_PORT=3306
DB_NAME=aquatap_db
DB_USER=root
DB_PASSWORD=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# How long a sign-in stays valid on the phone
JWT_EXPIRES_IN_DAYS=30

# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (type: Web application)
GOOGLE_WEB_CLIENT_ID=
GOOGLE_ADDITIONAL_CLIENT_IDS=

# true = allow email-only developer sign-in (local testing only)
AUTH_DEV_SIGN_IN_ENABLED=false

# AquaTap platform reviewers (comma separated): approve / reject station KYB documents
SYSTEM_ADMIN_EMAILS=

# Secret used to encrypt two-step verification (2FA) keys and backup codes in the database.
# Optional: when empty, JWT_SECRET is used. Set it once and never change it, or users must set up 2FA again.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
DATA_ENCRYPTION_KEY=

# Password / verification-code sign-in attempts allowed per minute from one IP address (default 10).
AUTH_RATE_LIMIT_PER_MINUTE=10
